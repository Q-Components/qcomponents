<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_picking_operations_remaining_qty_v19"
            model="ir.ui.view">
        <field name="name">stock.picking.operations.remaining.qty.v19</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Add Remaining Qty after Quantity column -->
            <xpath expr="//page[@name='operations']//list//field[@name='quantity']"
                   position="after">
                <field name="remaining_qty" readonly="1"/>
            </xpath>

        </field>
    </record>

</odoo>
