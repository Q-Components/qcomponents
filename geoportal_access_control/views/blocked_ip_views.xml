<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- TREE / LIST VIEW -->
    <record id="view_blocked_ip_tree" model="ir.ui.view">
        <field name="name">website.blocked.ip.list</field>
        <field name="model">website.blocked.ip</field>
        <field name="arch" type="xml">
            <list string="Blocked IPs" decoration-muted="not active">
                <field name="ip_address"/>
                <field name="active"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_blocked_ip_form" model="ir.ui.view">
        <field name="name">website.blocked.ip.form</field>
        <field name="model">website.blocked.ip</field>
        <field name="arch" type="xml">
            <form string="Blocked IP">
                <sheet>
                    <group>
                        <field name="ip_address" placeholder="e.g. 117.247.48.33" required="1"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_blocked_ip" model="ir.actions.act_window">
        <field name="name">Blocked IPs</field>
        <field name="res_model">website.blocked.ip</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU under Website → Reporting -->
    <menuitem id="menu_blocked_ip_root"
              name="Blocked IPs"
              parent="website.menu_reporting"
              action="action_blocked_ip"
              sequence="90"/>

</odoo>