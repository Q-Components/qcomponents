<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_check_ip_activity" model="ir.cron">
        <field name="name">GeoPortal: Check IP Activity and Auto-Block</field>
        <field name="model_id" ref="model_website_ip_activity"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_and_block()</field>
