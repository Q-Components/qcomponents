                                    vs Last Month
                                </small>

                                <small t-else=""
                                       class="text-danger">
                                    <i class="fa fa-arrow-down"/>
                                    <t t-esc="Math.abs(state.dashboard_data.kpis.profit_change)"/>%
                                    vs Last Month
                                </small>
                            </div>

                        </div>

                    </div>
                </div>
                <div class="col">
                    <div class="card shadow-lg border-0 sales-kpi-card">

                        <div class="card-body d-flex align-items-center">

                            <div class="sales-icon bg-info">
                                <i class="fa fa-percent text-white"/>
                            </div>

                            <div class="ms-3">
                                <div class="text-muted small">Gross Margin</div>

                                <h5 class="mb-0 fw-bold">
