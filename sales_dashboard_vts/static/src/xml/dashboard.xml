                                    vs Last Month
                                </small>

                                <small t-else=""
                                       class="text-success">
                                    <i class="fa fa-arrow-down"/>
                                    <t t-esc="Math.abs(state.dashboard_data.kpis.cancelled_orders_change)"/>%
                                    vs Last Month
                                </small>
                            </div>

                        </div>
                    </div>
                </div>
                <!-- Total Returns -->
                <!-- Total Returns -->
                <div class="col">
                    <div class="card shadow-lg border-0 sales-kpi-card dashboard-clickable"
                         t-on-click="() => this.openReturnRecords()">

                        <div class="card-body d-flex align-items-center">

                            <div class="sales-icon bg-warning">
                                <i class="fa fa-undo text-white"/>
                            </div>

