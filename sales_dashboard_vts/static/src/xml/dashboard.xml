            </div>
            <div class="row g-2 mb-2">
               <div class="col-3">
                   <div class="card dashboard-chart-card dashboard-chart-primary shadow-lg border-0 h-100">
                       <div class="card-header bg-white">
                           <h5 class="mb-0">
                               Monthly Sales Trend
                           </h5>
                       </div>

                       <div class="card-body">
                           <div class="chart-scroll-wrapper">
                               <canvas id="monthlySalesChart"
                                       style="height:220px;"/>
                           </div>
                       </div>
                   </div>
               </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card dashboard-chart-card dashboard-chart-success shadow-lg border-0 h-100">
                        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                Top Products
                            </h5>

                            <div class="d-flex align-items-center gap-1"
                                 t-if="topProductsTotalPages > 1">

                                <button class="btn btn-sm btn-light p-1 px-2"
                                        t-on-click="prevTopProductsPage"
                                        t-att-disabled="state.topProductsPage === 0">
                                    <i class="fa fa-chevron-left"/>
                                </button>

                                <span class="small text-muted">
                                    <t t-esc="state.topProductsPage + 1"/> / <t t-esc="topProductsTotalPages"/>
                                </span>

                                <button class="btn btn-sm btn-light p-1 px-2"
                                        t-on-click="nextTopProductsPage"
                                        t-att-disabled="state.topProductsPage >= topProductsTotalPages - 1">
                                    <i class="fa fa-chevron-right"/>
                                </button>

                            </div>
                        </div>

                        <div class="card-body">
                            <div style="height:220px;">
                                <canvas id="topProductsChart"/>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
