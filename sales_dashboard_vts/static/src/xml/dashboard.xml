                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-lg border-0 h-100 alert-card">

                        <div class="card-header border-0 alert-card-header">
                            <h5 class="mb-0">
                                Alerts &amp; Action Required
                            </h5>
                        </div>

                        <div class="card-body p-3">

                            <div class="alert-item">
                                <div class="alert-left">
                                    <div class="alert-icon warning">
                                        <i class="fa fa-exclamation-triangle"/>
                                    </div>
                                    <span>Stock Shortage on Ordered Items</span>
                                </div>

                                <span class="alert-badge warning">
                                    <t t-esc="state.dashboard_data.alerts.stock_shortage"/>
                                </span>
                            </div>

                            <div class="alert-item">
