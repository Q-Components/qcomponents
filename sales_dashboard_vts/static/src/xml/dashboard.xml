<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="sales_dashboard_vts.SalesDashboard">
        <div class="container-fluid py-3 sales-dashboard-theme h-100 overflow-auto" style="min-height:0; max-height:100%;">
            <div class="row g-2 mb-1">

                <div class="d-flex justify-content-start">

                    <div class="card border dashboard-date-card">
                        <div class="card-body py-2 px-3">

                            <div class="d-flex align-items-center gap-2">

                                <i class="fa fa-calendar"/>

                                <input type="date"
                                       class="border-0 bg-transparent"
                                       t-model="state.filters.date_from"/>

                                <span>-</span>

                                <input type="date"
                                       class="border-0 bg-transparent"
                                       t-model="state.filters.date_to"/>

                                <button class="btn btn-primary"
                                        t-on-click="loadDashboardData">
                                    Apply
                                </button>

                            </div>

                        </div>
                    </div>

                </div>

            </div>
            <!-- KPI Cards Row -->
            <div class="row g-2 mb-2">

                <!-- Total Sales -->
                <div class="col">
                    <div class="card shadow-lg border-0 sales-kpi-card dashboard-clickable"
                         t-on-click="() => this.openRecords(
                            'sale.order',
                            'Sales Orders',
                            [['state', 'in', ['sale', 'done']]]
                         )">

                        <div class="card-body d-flex align-items-center">

                            <div class="sales-icon bg-success">
                                <i class="fa fa-money text-white"/>
                            </div>

                            <div class="ms-3">
                                <div class="text-muted small">Total Sales</div>

                                <h5 class="mb-0 fw-bold">
                                    <t t-esc="state.dashboard_data.currency.symbol"/>
                                    <t t-esc="state.dashboard_data.kpis.total_sales || 0"/>
                                </h5>

                                <small t-if="state.dashboard_data.kpis.total_sales_change >= 0"
                                       class="text-success">
                                    <i class="fa fa-arrow-up"/>
                                    <t t-esc="state.dashboard_data.kpis.total_sales_change"/>%
                                    vs Last Month
                                </small>

                                <small t-else=""
                                       class="text-danger">
                                    <i class="fa fa-arrow-down"/>
                                    <t t-esc="Math.abs(state.dashboard_data.kpis.total_sales_change)"/>%
                                    vs Last Month
                                </small>
                            </div>



                        </div>
                    </div>
                </div>

                <!-- Total Orders -->
                <div class="col">
                    <div class="card shadow-lg border-0 sales-kpi-card dashboard-clickable"
                         t-on-click="() => this.openRecords(
                            'sale.order',
                            'Sale Orders',
                            [['state', 'in', ['sale', 'done']]]
                         )">

                        <div class="card-body d-flex align-items-center">

                            <div class="sales-icon bg-primary">
                                <i class="fa fa-shopping-bag text-white"/>
                            </div>

                            <div class="ms-3">
                                <div class="text-muted small">Total Orders</div>
                                <h5 class="mb-0 fw-bold">
                                    <t t-esc="state.dashboard_data.kpis.total_sale_orders || 0"/>
                                </h5>
                                <small t-if="state.dashboard_data.kpis.total_sale_orders_change >= 0"
                                       class="text-success">
                                    <i class="fa fa-arrow-up"/>
                                    <t t-esc="state.dashboard_data.kpis.total_sale_orders_change"/>%
                                    vs Last Month
                                </small>

                                <small t-else=""
                                       class="text-danger">
                                    <i class="fa fa-arrow-down"/>
                                    <t t-esc="Math.abs(state.dashboard_data.kpis.total_sale_orders_change)"/>%
                                    vs Last Month
                                </small>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Quotations -->
                <div class="col">
                    <div class="card shadow-lg border-0 sales-kpi-card dashboard-clickable"
                         t-on-click="() => this.openRecords(
                            'sale.order',
                            'Quotations',
                            [['state', 'in', ['draft', 'sent']]]
                         )">

                        <div class="card-body d-flex align-items-center">

                            <div class="sales-icon bg-purple">
                                <i class="fa fa-file-text-o text-white"/>
                            </div>

                            <div class="ms-3">
                                <div class="text-muted small">Quotations</div>
                                <h5 class="mb-0 fw-bold">
                                    <t t-esc="state.dashboard_data.kpis.total_quotations || 0"/>
                                </h5>
                                <small t-if="state.dashboard_data.kpis.total_quotations_change >= 0"
                                       class="text-success">
                                    <i class="fa fa-arrow-up"/>
                                    <t t-esc="state.dashboard_data.kpis.total_quotations_change"/>%
                                    vs Last Month
                                </small>

                                <small t-else=""
                                       class="text-danger">
                                    <i class="fa fa-arrow-down"/>
                                    <t t-esc="Math.abs(state.dashboard_data.kpis.total_quotations_change)"/>%
                                    vs Last Month
                                </small>
                            </div>

                        </div>
                    </div>
                </div>

               
                <!-- Average Order Value -->
                <div class="col">
                    <div class="card shadow-lg border-0 sales-kpi-card">
                        <div class="card-body d-flex align-items-center">

                            <div class="sales-icon bg-info">
                                <i class="fa fa-shopping-cart text-white"/>
                            </div>

                            <div class="ms-3">
                                <div class="text-muted small">Avg Order Value</div>

                                <h5 class="mb-0 fw-bold">
                                    <t t-esc="state.dashboard_data.currency.symbol"/>
                                    <t t-esc="state.dashboard_data.kpis.avg_order_value || 0"/>
                                </h5>

                                <small t-if="state.dashboard_data.kpis.avg_order_value_change >= 0"
                                       class="text-success">
                                    <i class="fa fa-arrow-up"/>
                                    <t t-esc="state.dashboard_data.kpis.avg_order_value_change"/>%
                                    vs Last Month
                                </small>

                                <small t-else=""
                                       class="text-danger">
                                    <i class="fa fa-arrow-down"/>
                                    <t t-esc="Math.abs(state.dashboard_data.kpis.avg_order_value_change)"/>%
                                    vs Last Month
                                </small>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Cancelled Orders -->
                <div class="col">
                    <div class="card shadow-lg border-0 sales-kpi-card dashboard-clickable"
                         t-on-click="() => this.openRecords(
                            'sale.order',
                            'Cancelled Orders',
                            [['state', '=', 'cancel']]
                         )">

                        <div class="card-body d-flex align-items-center">

                            <div class="sales-icon bg-cancel">
                                <i class="fa fa-times-circle text-white"/>
                            </div>

                            <div class="ms-3">
                                <div class="text-muted small">Cancelled Orders</div>
                                <h5 class="mb-0 fw-bold">
                                    <t t-esc="state.dashboard_data.kpis.cancelled_orders || 0"/>
                                </h5>
                                <small t-if="state.dashboard_data.kpis.cancelled_orders_change >= 0"
                                       class="text-danger">
                                    <i class="fa fa-arrow-up"/>
