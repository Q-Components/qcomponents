                <div class="col-lg-3 col-md-6">
                    <div class="card dashboard-chart-card dashboard-chart-teal shadow-lg border-0 h-100">

                        <div class="card-header bg-white border-0">
                            <h5 class="mb-0">Top 10 Suppliers</h5>
