                                </small>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card shadow-lg border-0 sales-kpi-card">

                        <div class="card-body d-flex align-items-center">

                            <div class="sales-icon bg-success">
                                <i class="fa fa-line-chart text-white"/>
                            </div>

                            <div class="ms-3">
                                <div class="text-muted small">Gross Profit</div>
                                <h5 class="mb-0 fw-bold">
                                    <t t-esc="state.dashboard_data.currency.symbol"/>
                                    <t t-esc="state.dashboard_data.kpis.profit || 0"/>
                                </h5>
                                <small t-if="state.dashboard_data.kpis.profit_change >= 0"
                                       class="text-success">
                                    <i class="fa fa-arrow-up"/>
