<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_unlink_filestore_tree" model="ir.ui.view">
        <field name="name">unlink.filestore.tree</field>
        <field name="model">unlink.filestore</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_id"/>
                <field name="mime_type"/>
                <field name="record_limit"/>
                <field name="matching_attachment_count"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'confirm'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_unlink_filestore_form" model="ir.ui.view">
        <field name="name">unlink.filestore.form</field>
        <field name="model">unlink.filestore</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_preview_records" string="Preview Model Records" type="object" class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_preview_attachments" string="Preview Attachments to Delete" type="object" class="btn-secondary" invisible="state == 'done'"/>
                    <button name="confirm" string="Confirm" type="object" invisible="state not in ['draft', 'in_progress']"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="model_id" required="1" readonly="state == 'done'"/>
                            <field name="model_name" invisible="1"/>
                            <field name="filter_domain" widget="domain"
                                   options="{'model': 'model_name', 'in_dialog': True}"
                                   readonly="state != 'draft'"/>
                            <field name="record_limit" required="1" readonly="state == 'done'"/>
                            <field name="mime_type" required="1" placeholder="Ex: text/html, application/pdf, e.t.c"
                                   readonly="state == 'done'"/>
                        </group>
                        <group string="Last Preview / Cleanup Summary">
                            <field name="matching_record_count" readonly="1"/>
                            <field name="matching_attachment_count" readonly="1"/>
                            <field name="preview_attachment_count" readonly="1"/>
                            <field name="preview_date" readonly="1"/>
                            <div colspan="2" class="text-muted">Model preview uses the selected model domain. Attachment preview also applies MIME Type and the limit. When Model Name is Attachment, the attachment records are filtered directly.</div>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="unlink_attachment_manual_delete_form" model="ir.ui.view">
        <field name="name">unlink.attachment.manual.delete.form</field>
        <field name="model">unlink.attachment.manual.delete</field>
        <field name="arch" type="xml">
            <form string="Confirm Attachment Deletion">
                <group>
                    <div class="alert alert-danger" role="alert" colspan="2">
                        This will permanently delete the selected attachment records.
                        Their stored files will be cleaned up using Odoo's filestore handling.
                        This cannot be undone.
                    </div>
                    <field name="cleanup_id" invisible="1"/>
                    <field name="selected_count" readonly="1"/>
                    <field name="attachment_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm_delete" string="Delete Selected Attachments" type="object" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="server_action_manual_delete_from_preview" model="ir.actions.server">
        <field name="name">Delete Selected Attachments (Cleanup Preview)</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="binding_model_id" ref="base.model_ir_attachment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env['unlink.filestore'].action_open_manual_delete_wizard(records)</field>
    </record>

    <record id="unlink_filestore_action" model="ir.actions.act_window">
        <field name="name">Unlink Attachment-Filestore</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">unlink.filestore</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_unlink_filestore__settings_menu"
              name="Unlink Attachment-Filestore"
              parent="base.menu_administration"
              action="unlink_filestore_action"
              sequence="200"/>

    <record model="ir.actions.server" id="action_confirm_unlink_bulk_attachment_with_filestore">
        <field name="name">Confirm Unlink</field>
        <field name="model_id" ref="unlink_attachment_with_filestore_vts.model_unlink_filestore"/>
        <field name="binding_model_id" ref="unlink_attachment_with_filestore_vts.model_unlink_filestore"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">
            if records:
            records.action_bulk_confirm_records()
        </field>
    </record>

</odoo>
