<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fedex_view_stock_picking_package_details" model="ir.ui.view">
        <field name="name">Fedex Package Configuration</field>
        <field name="model">stock.picking</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="create_return_order" string="FedEx Return" type="object"
                        invisible="picking_type_code == 'outgoing' or state in ['done','cancel'] or carrier_tracking_ref or not carrier_id"/>
                <button name="export_order_to_fedex" string="Export to Fedex" type="object"
                        invisible="picking_type_code != 'outgoing' or state != 'done' or carrier_tracking_ref or not carrier_id or delivery_type != 'fedex_shipping_provider'"
                        />
            </xpath>
        </field>
    </record>

    <record id="fedex_view_stock_package_details" model="ir.ui.view">
        <field name="name">Fedex Package Configuration</field>
        <field name="model">stock.package</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="stock.stock_package_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">
                <field name="custom_tracking_number" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>

