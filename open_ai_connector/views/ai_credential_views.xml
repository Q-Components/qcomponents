<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_credential_list" model="ir.ui.view">
        <field name="name">ai.credential.list</field>
        <field name="model">ai.credential</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'connected'" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="provider_id"/>
                <field name="auth_type"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'" decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_ai_credential_form" model="ir.ui.view">
        <field name="name">ai.credential.form</field>
        <field name="model">ai.credential</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="oe_highlight" invisible="auth_type == 'external_process'"/>
                    <button name="action_fetch_models" type="object" string="Fetch Models"
                            invisible="auth_type == 'external_process'"/>
                    <button name="action_oauth_start" type="object" string="Start OAuth"
                            invisible="auth_type not in ('oauth_external', 'oauth_device_code')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_models" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="model_count" widget="statinfo" string="Models"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Connected" bg_color="text-bg-success"
                            invisible="state != 'connected'"/>
                    <widget name="web_ribbon" title="Error" bg_color="text-bg-danger"
                            invisible="state != 'error'"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. OpenRouter (prod)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider_id"/>
                            <field name="auth_type" readonly="1"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="state" readonly="1"/>
                            <field name="last_tested" readonly="1"/>
                            <field name="last_test_message" readonly="1"/>
                        </group>
                    </group>

                    <group string="API Key" invisible="auth_type not in ('api_key', 'copilot')">
                        <field name="api_key" password="True"/>
                        <field name="base_url" placeholder="Override (required for Custom / Azure Foundry)"/>
                        <field name="extra_headers" placeholder='{"X-Title": "..."}'/>
                        <field name="proxy_url"/>
                    </group>

                    <group string="AWS Credentials" invisible="auth_type != 'aws_sdk'">
                        <field name="aws_access_key_id"/>
                        <field name="aws_secret_access_key" password="True"/>
                        <field name="aws_session_token" password="True"/>
                        <field name="aws_region"/>
                    </group>

                    <group string="OAuth" invisible="auth_type not in ('oauth_external', 'oauth_device_code')">
                        <field name="oauth_token_expiry" readonly="1"/>
                        <field name="base_url" placeholder="Inference base URL override"/>
                        <field name="gemini_project_id"
                               invisible="provider_code != 'google-gemini-cli'"
                               placeholder="Auto-discovered (free tier) — set to pin a paid GCP project"/>
                        <separator string="Client &amp; endpoints (auto-filled — edit only for a custom OAuth app)" colspan="2"/>
                        <field name="oauth_client_id"/>
                        <field name="oauth_client_secret" password="True"/>
                        <field name="oauth_auth_url" invisible="auth_type != 'oauth_external'"/>
                        <field name="oauth_device_authorization_url" invisible="auth_type != 'oauth_device_code'"/>
                        <field name="oauth_token_url"/>
                        <field name="oauth_scopes"/>
                    </group>

                    <div class="alert alert-info" role="alert" invisible="auth_type != 'external_process'">
                        This provider uses an external local process (Copilot ACP) and is not
                        callable from Odoo.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ai_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">ai.credential</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first AI provider credential</p>
            <p>Store an API key (or AWS / OAuth credentials) for a provider, then test it.</p>
        </field>
    </record>

</odoo>
