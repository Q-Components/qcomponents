<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- `sequence` drives list order (model _order = 'sequence, name'): lower = higher.
         Curated so the most popular providers float to the top; the long tail shares
         sequence 500 and sorts alphabetically. These values live in the noupdate=1
         records below, so existing installs get them from migrations/19.0.1.8.0
         (keep that migration's SEQUENCE_BY_CODE in sync with the values here). -->
