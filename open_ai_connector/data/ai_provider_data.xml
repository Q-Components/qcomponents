        <!-- ============ chat_completions / api_key ============ -->

        <record id="provider_alibaba" model="ai.provider">
            <field name="sequence">80</field>
            <field name="name">Alibaba Cloud (DashScope)</field>
            <field name="code">alibaba</field>
            <field name="aliases">dashscope,alibaba-cloud,qwen-dashscope</field>
            <field name="env_vars">DASHSCOPE_API_KEY</field>
            <field name="base_url">https://dashscope-intl.aliyuncs.com/compatible-mode/v1</field>
        </record>

