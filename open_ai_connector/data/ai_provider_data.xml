        <!-- ============ anthropic_messages ============ -->

        <record id="provider_anthropic" model="ai.provider">
            <field name="sequence">20</field>
            <field name="name">Anthropic (Claude)</field>
            <field name="code">anthropic</field>
            <field name="aliases">claude</field>
            <field name="api_mode">anthropic_messages</field>
            <field name="env_vars">ANTHROPIC_API_KEY,ANTHROPIC_TOKEN,CLAUDE_CODE_OAUTH_TOKEN</field>
            <field name="base_url">https://api.anthropic.com</field>
            <field name="signup_url">https://console.anthropic.com/settings/keys</field>
            <field name="default_aux_model">claude-haiku-4-5-20251001</field>
            <field name="supports_vision">1</field>
        </record>

        <!-- claude.ai Pro/Max login via OAuth (PKCE). Same Messages API as the
             api-key provider above, but tokens auth via Bearer + anthropic-beta
             (see tools/auth.py) and the token endpoint speaks JSON. OAuth client
             + endpoints are seeded in data/ai_provider_oauth_data.xml. -->
        <record id="provider_claude_oauth" model="ai.provider">
            <field name="sequence">25</field>
            <field name="name">Claude (claude.ai OAuth)</field>
            <field name="code">claude-oauth</field>
            <field name="aliases">claude-code,claude-pro,claude-max</field>
            <field name="api_mode">anthropic_messages</field>
            <field name="auth_type">oauth_external</field>
            <field name="base_url">https://api.anthropic.com</field>
            <field name="signup_url">https://claude.ai</field>
            <field name="default_aux_model">claude-haiku-4-5-20251001</field>
            <field name="supports_vision">1</field>
            <!-- No seeded fallback_models: the live /v1/models fetch (OAuth Bearer
                 + uTLS) is the source of truth, so the catalog never shows stale
                 hardcoded model ids. -->
        </record>

