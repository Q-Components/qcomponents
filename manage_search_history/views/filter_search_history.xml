<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>  
        <record id="filter_search_history_view_form" model="ir.ui.view">
            <field name="name">filter.search.history.view.form</field>
            <field name="model">filter.search.history</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="field_name" />
                            <field name="shared_user_ids" widget="many2many_tags"/>
                            <field name="domain" /> 
                            <field name="model_id" /> 
                            <field name="action_id" /> 
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="filter_search_history_view_tree" model="ir.ui.view">
            <field name="name">filter.search.history.view.tree</field>
            <field name="model">filter.search.history</field>
            <field name="arch" type="xml">
                <list>
                    <field name="field_name" />
                </list>
            </field>
        </record>
        <record id="filter_search_history_action" model="ir.actions.act_window">
            <field name="name">Filter Search History</field>
            <field name="res_model">filter.search.history</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
        </record>
        <menuitem id="filter_search_history_menu" name="Filter Search History" action="filter_search_history_action" parent="base.next_id_2" sequence="16"/>
    </data>
</odoo>
