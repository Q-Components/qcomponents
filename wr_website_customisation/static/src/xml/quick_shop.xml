<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="QuickShopTemplate">
        <div class="oe_quick_shop_view">
            <!-- Search & Sort -->
            <div class="row align-items-start flex-nowrap">
                <div class="col-1"/>
                <div class="col-10">
                    <div role="search" class="input-group w-100">
                        <input type="search" class="form-control border-0 text-bg-light"
                               placeholder="Search..." t-att-value="widget.term"/>
                        <button aria-label="Search" title="Search" class="btn btn-light term_search_btn">
                            <i class="oi oi-search"></i>
                            <span class="oe_search_found">
                                <small>(<t t-esc="widget.data.total_products"/> found)</small>
                            </span>
                        </button>
                        <!-- Sort by -->
                        <div class="o_sortby_dropdown dropdown dropdown_sorty_by ms-lg-3 d-none d-lg-inline-block ms-3">
                            <small class="d-none d-lg-inline text-muted">Sort By:</small>
                            <a role="button" href="#" data-bs-toggle="dropdown" class="dropdown-toggle btn btn-light">
                                <span class="d-none d-lg-inline">
                                    <t t-foreach="widget.filters" t-as="filter" t-key="filter">
                                        <t t-if="filter == widget.active_filter">
                                            <span><t t-esc="widget.filters[filter]"/></span>
                                        </t>
                                    </t>
                                </span>
                                <i class="fa fa-sort-amount-asc d-lg-none"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end" role="menu">
                                <a role="menuitem" class="dropdown-item quick_shop_filter"
                                   t-foreach="widget.filters" t-as="filter" t-key="filter"
                                   t-att-data-filter="filter">
                                    <span><t t-esc="widget.filters[filter]"/></span>
                                </a>
                            </div>
                        </div>
                        <!-- View type buttons -->
                        <div class="btn-group ms-3 d-flex ms-3 ms-auto">
                            <label title="Grid"
                                   t-attf-class="o_view_type btn btn-light #{widget.view_type == 'grid' ? 'border-primary' : ''}"
                                   data-view-type="grid">
                                <i class="fa fa-th-large"></i>
                            </label>
                            <label title="List"
                                   t-attf-class="o_view_type btn btn-light #{widget.view_type == 'list' ? 'border-primary' : ''}"
                                   data-view-type="list">
                                <i class="oi oi-view-list"></i>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-1"/>
            </div>

            <!-- Products Grid/List -->
            <div class="row align-items-start flex-nowrap mt-3">
                <div class="col-1"/>
                <div class="col-10">
                    <!-- List View -->
                    <table class="table table-borderless h-100 m-0 o_wsale_context_thumb_cover"
                           t-if="widget.view_type == 'list'">
                        <colgroup>
                            <col width="15%"/>
                            <col width="85%"/>
                        </colgroup>
                        <tr t-foreach="widget.data.products" t-as="product" t-key="product.id" class="oe_product_cart">
                            <td class="oe_product_cart h-100 d-flex ps-0">
                                <div class="oe_product_image position-relative h-100 overflow-hidden">
                                    <a class="oe_product_image_link d-block h-100 position-relative"
                                       contenteditable="false" t-att-href="product.website_url">
                                        <span class="oe_product_image_img_wrapper d-flex h-100 justify-content-center align-items-center position-absolute">
                                            <img t-attf-src="/web/image/product.product/{{product.id}}/image_512/"
                                                 itemprop="image" class="img img-fluid position-absolute"
                                                 t-att-alt="product.name" loading="lazy" style="height:100px;"/>
                                        </span>
                                    </a>
                                </div>
                            </td>
                            <td>
                                <div class="o_wsale_product_information position-relative">
                                    <h6 class="o_wsale_products_item_title mb-2">
                                        <a t-att-href="product.website_url"
                                           class="text-primary text-decoration-none cursor-pointer fw-bolder">
                                            <t t-esc="product.name"/>
                                        </a>
                                    </h6>
                                    <div t-if="product.x_studio_alternate_number">
                                        <a class="text-primary text-decoration-none">
                                            <t t-esc="product.x_studio_alternate_number"/>
                                        </a>
                                    </div>
                                    <div t-if="product.qty_available &gt; 0">
                                        <span class="fw-bold"><t t-esc="product.qty_available"/></span>
                                        <span class="fw-bold" t-if="product.uom_id and product.uom_id.length &gt; 0">
                                            <t t-esc="product.uom_id[1]"/>
                                        </span>
                                        <span class="fw-bold">left in stock.</span>
                                    </div>
                                    <div class="oe_subdescription mb-2 text-muted small"
                                         contenteditable="false" t-if="product.description_sale">
                                        <div><t t-esc="product.description_sale"/></div>
                                    </div>
                                    <div id="o_wsale_cta_wrapper" class="d-block text-end" t-if="product.price &gt; 0">
                                        <div contenteditable="false" style="padding: 0.2rem 1rem;height: 45px;"
                                             class="css_quantity input-group d-inline-flex me-2 mb-2 align-middle">
                                            <a class="btn btn-link js_decrease_qty" aria-label="Remove one"
                                               title="Remove one" href="#" style="padding: 0.3rem 1rem;">
                                                <i class="fa fa-minus"></i>
                                            </a>
                                            <input type="text" class="form-control text-center p-0" data-min="1"
                                                   name="product_qty" value="1" title=""/>
                                            <a class="btn btn-link float_left js_increase_qty" aria-label="Add one"
                                               title="Add one" href="#" style="padding: 0.3rem 1rem;">
                                                <i class="fa fa-plus"></i>
                                            </a>
                                        </div>
                                        <div id="add_to_cart_wrap" class="d-inline-flex align-items-center mb-2 me-auto">
                                            <a role="button" href="#" t-att-data-product-id="product.id"
                                               class="btn btn-primary add_to_cart flex-grow-1">
                                                <i class="fa fa-shopping-cart me-2"></i>
                                                <span style="font-weight: bold">ADD TO CART</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Grid View -->
                    <div class="row" t-if="widget.view_type == 'grid'">
                        <div class="col-md-3" t-foreach="widget.data.products" t-as="product" t-key="product.id">
                            <div class="card oe_product_cart">
                                <div class="card-body p-1 oe_product_image">
                                    <a class="d-block h-100" itemprop="url" t-att-href="product.website_url">
                                        <span class="d-flex h-100 justify-content-center align-items-center">
                                            <img t-attf-src="/web/image/product.product/{{product.id}}/image_512/"
                                                 class="img img-fluid" t-att-alt="product.name" loading="lazy"/>
                                        </span>
                                    </a>
                                </div>
                                <div class="card-body p-0 text-center o_wsale_product_information">
                                    <div class="p-2 o_wsale_product_information_text">
                                        <h6 class="o_wsale_products_item_title">
                                            <a t-att-href="product.website_url"><t t-esc="product.name"/></a>
                                            <div t-if="product.x_studio_alternate_number">
                                                <a><t t-esc="product.x_studio_alternate_number"/></a>
                                            </div>
                                        </h6>
                                        <div>
                                            <span style="font-size: 95%;"><t t-esc="product.qty_available"/></span>
                                            <span style="font-size: 75%;" t-if="product.uom_id and product.uom_id.length &gt; 0">
                                                <t t-esc="product.uom_id[1]"/>
                                            </span>
                                            <span style="font-size: 75%;">left in stock.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pagination -->
                    <div class="row">
                        <div class="col-12">
                            <div class="products_pager d-flex justify-content-center pt-5 pb-3">
                                <ul class="pagination m-0 align-items-center">
                                    
                                    <li t-attf-class="page-item #{widget.offset == 0 ? 'disabled' : ''}">
                                        <button class="page-link pagination-prev-btn" type="button">
                                            <span class="oi oi-chevron-left"></span>
                                        </button>
                                    </li>

                                    <t t-foreach="widget.data.pages" t-as="page" t-key="page">
                                        <li t-attf-class="page-item #{page == Math.ceil(widget.offset / widget.limit) + 1 ? 'active' : ''}">
                                            <button type="button"
                                                    class="page-link pagination-page-btn"
                                                    t-att-data-offset="(page - 1) * widget.limit">
                                                <t t-esc="page"/>
                                            </button>
                                        </li>
                                    </t>

                                    <li t-attf-class="page-item #{widget.data.total_products == (widget.data.next_offset &gt; widget.data.total_products ? widget.data.total_products : widget.data.next_offset) ? 'disabled' : ''}">
                                        <button class="page-link pagination-next-btn" type="button">
                                            <span class="oi oi-chevron-right"></span>
                                        </button>
                                    </li>

                                </ul>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-1"/>
            </div>
        </div>
    </t>
</templates>