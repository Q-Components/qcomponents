<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="cart" inherit_id="website_sale.cart">
            <xpath expr="//div[@id='shop_cart']/div[@class='d-flex align-items-center mb-3']" position="before">
                <t t-set="min_amount" t-value="website.check_cart_amount()"/>
                <t t-set="message" t-value="website.info_message()"/>
                <div id="message" t-attf-class="col-12 #{'d-none' if min_amount else ''}">
                    <div class="alert alert-warning my-2 checkout_one">
                        <em>
                            <i class="fa fa-info-circle"/>
                            <t t-esc="message"/>
                        </em>
                    </div>
                </div>
            </xpath>
<!--            <xpath expr="//div[hasclass('oe_cart')]//div[hasclass('justify-content-between')]/div[hasclass('flex-column')]/a"-->
<!--                   position="attributes">-->
<!--                <attribute name="t-attf-class">btn btn-primary float-right checkout_one-->
<!--                    #{"disabled" if not website.check_cart_amount() else ""}-->
<!--                </attribute>-->
<!--            </xpath>-->


        </template>


        <template id="checkout_button_limit" inherit_id="website_sale.navigation_buttons">
            <xpath expr="//a[@name='website_sale_main_button']" position="attributes">
                <attribute name="t-attf-class">btn btn-primary w-100 checkout_one
                    #{"disabled" if not website.check_cart_amount() else ""}
<!--                    #{'disabled' if not website_sale_order or website_sale_order.amount_total &lt; 100 else ''}-->
                </attribute>
            </xpath>

<!--            <xpath expr="//a[@name='website_sale_main_button']" position="attributes">-->
<!--                <attribute name="t-att-href">-->
<!--                    #{"disabled" if not website.check_cart_amount() else ""}-->
<!--&lt;!&ndash;                    #{'' if not website_sale_order or website_sale_order.amount_total &lt; 100 else next_website_checkout_step_href}&ndash;&gt;-->
<!--                </attribute>-->
<!--                -->
<!--            </xpath>-->

        </template>


<!--        <template id="short_cart_summary" inherit_id="website_sale.short_cart_summary">-->
<!--            <xpath expr="//a" position="attributes">-->
<!--                <attribute name="t-attf-class">btn btn-secondary float-end d-none d-xl-inline-block checkout_one-->
<!--                    #{"disabled" if not website.check_cart_amount() else ""}-->
<!--                </attribute>-->
<!--            </xpath>-->
<!--        </template>-->


        <!-- Product list extra fields -->
        <template id="add_extra_fields_on_product_view" inherit_id="website_sale.products_item"
                  name="Show Extra Fields On Products" priority="20">
            <xpath expr="//h2[contains(@class,'o_wsale_products_item_title')]
                 | //h6[contains(@class,'o_wsale_products_item_title')]" position="after">
                <div>
                    <a class="text-primary text-decoration-none" itemprop="x_studio_alternate_number"
                       t-att-content="product.x_studio_alternate_number"
                       t-field="product.x_studio_alternate_number"/>
                </div>
                <t t-if="product.sudo().qty_available">
                    <div>
                        <span class="fw-bold" t-esc="str(int(product.sudo().qty_available))"/>
                        <span class="fw-bold" t-esc="product.sudo().uom_id.name"/>
                        <span class="fw-bold">left in stock.</span>
                    </div>
                </t>
            </xpath>
        </template>

        <!-- Product detail page extra fields -->
        <template id="add_extra_fields_on_product_main_form_view" inherit_id="website_sale.product"
                  name="Show Extra Fields On Products Main View" priority="4">
            <xpath expr="//div[contains(@class,'o_wsale_product_details_content_section')]" position="inside">
                <div>
                    <a class="text-primary text-decoration-none" itemprop="x_studio_alternate_number"
                       t-att-content="product.x_studio_alternate_number"
                       t-field="product.x_studio_alternate_number"/>
                </div>
                <t t-if="product.sudo().qty_available">
                    <div>
                        <span class="fw-bold" t-esc="str(int(product.sudo().qty_available))" style="margin-right:4px;"/>
                        <span class="fw-bold" t-esc="product.sudo().uom_id.name" style="margin-right:4px;"/>
                        <span class="fw-bold">left in stock.</span>
                    </div>
                </t>
            </xpath>
        </template>

    </data>
</odoo>
