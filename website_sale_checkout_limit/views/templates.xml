<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Cart warning message -->
        <template id="cart_message" inherit_id="website_sale.cart_summary_content">
            <xpath expr="//div[1]" position="before">
                <t t-set="order" t-value="website_sale_order"/>
                <t t-set="min_amount" t-value="order and order.amount_total >= 100"/> <!-- Replace 100 with your minimum -->
                <t t-set="message" t-value="'Minimum cart amount is 100.'"/>
                <div id="message" t-attf-class="col-12 #{'d-none' if min_amount else ''}">
                    <div class="alert alert-warning my-2">
                        <em>
                            <i class="fa fa-info-circle"/>
                            <t t-esc="message"/>
                        </em>
                    </div>
                </div>
            </xpath>
        </template>

        <!-- Checkout button control -->
        <template id="checkout_button_limit" inherit_id="website_sale.navigation_buttons">
            <xpath expr="//a[@name='website_sale_main_button']" position="attributes">
                <attribute name="t-attf-class">btn btn-primary w-100
                    #{'disabled' if not website_sale_order or website_sale_order.amount_total &lt; 100 else ''}
                </attribute>
            </xpath>

            <xpath expr="//a[@name='website_sale_main_button']" position="attributes">
                <attribute name="t-att-href">
                    #{'' if not website_sale_order or website_sale_order.amount_total &lt; 100 else next_website_checkout_step_href}
                </attribute>
            </xpath>
        </template>


        <!-- Product list extra fields -->
        <template id="add_extra_fields_on_product_view" inherit_id="website_sale.products_item"
                  name="Show Extra Fields On Products" priority="20">
            <xpath expr="//h2[contains(@class,'o_wsale_products_item_title')]
                 | //h6[contains(@class,'o_wsale_products_item_title')]" position="after">
                <div>
                    <a class="text-primary text-decoration-none" itemprop="x_studio_alternate_number"
                       t-att-content="product.x_studio_alternate_number"
                       t-field="product.x_studio_alternate_number"/>
                </div>
                <t t-if="product.sudo().qty_available">
                    <div>
                        <span class="fw-bold" t-esc="str(int(product.sudo().qty_available))"/>
                        <span class="fw-bold" t-esc="product.sudo().uom_id.name"/>
                        <span class="fw-bold">left in stock.</span>
                    </div>
                </t>
            </xpath>
        </template>

        <!-- Product detail page extra fields -->
        <template id="add_extra_fields_on_product_main_form_view" inherit_id="website_sale.product"
                  name="Show Extra Fields On Products Main View" priority="4">
            <xpath expr="//div[contains(@class,'o_wsale_product_details_content_section')]" position="inside">
                <div>
                    <a class="text-primary text-decoration-none" itemprop="x_studio_alternate_number"
                       t-att-content="product.x_studio_alternate_number"
                       t-field="product.x_studio_alternate_number"/>
                </div>
                <t t-if="product.sudo().qty_available">
                    <div>
                        <span class="fw-bold" t-esc="str(int(product.sudo().qty_available))"/>
                        <span class="fw-bold" t-esc="product.sudo().uom_id.name"/>
                        <span class="fw-bold">left in stock.</span>
                    </div>
                </t>
            </xpath>
        </template>

    </data>
</odoo>
