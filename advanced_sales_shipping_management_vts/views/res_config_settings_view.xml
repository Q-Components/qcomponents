<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_sales_dashboard" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.sales.dashboard</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
    <field name="arch" type="xml">

        <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">

                <setting string="Pending Deliveries Period (Days)"
                         help="Only sales orders created within the last specified number of days will be considered for Pending Deliveries. Older records will be excluded from the dashboard calculation.">
                    <field name="pending_delivery_days"/>
                </setting>

                <setting string="Overdue Sales Orders Period (Days)"
                         help="Define the number of recent days to consider when calculating Overdue Sale Orders in the dashboard. Sale orders older than this period will be excluded from the analysis.">
                    <field name="overdue_sale_days"/>
                </setting>

        </xpath>

    </field>
</record>
</odoo>