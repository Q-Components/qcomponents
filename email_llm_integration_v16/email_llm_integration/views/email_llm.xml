<odoo>
    <!-- Tree View -->
    <record id="view_email_llm_tree" model="ir.ui.view">
        <field name="name">email.llm.tree</field>
        <field name="model">email.llm</field>
        <field name="arch" type="xml">
            <tree>
                <field name="email_sender_name"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_email_llm_form" model="ir.ui.view">
        <field name="name">email.llm.form</field>
        <field name="model">email.llm</field>
        <field name="arch" type="xml">
            <form>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_sale_order"
                            type="object"
                            attrs="{'invisible': [('generated_sale_order_id', '=', False)]}"
                            string="Quotation"
                            icon="fa-shopping-cart"
                            class="oe_stat_button"/>
                </div>
                <group>
                    <field name="generated_sale_order_id" invisible="1"/>
                    <field name="email_sender_name"/>
                    <field name="email_body"/>
                    <field name="llm_error_value" readonly="1"/>
                    <field name="gpt_response" invisible="1"/>
                    <field name="matched_product_data" invisible="1"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tree_email_llm" model="ir.actions.act_window" >
        <field name="name">Emails</field>
        <field name="res_model">email.llm</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_root_email_llm_integration"
              name="Emails"
              sequence="0"/>
    <menuitem id="menu_email_llm"
              action="action_tree_email_llm"
              name="Emails to Process"
              parent="menu_root_email_llm_integration"
              sequence="1"/>
</odoo>