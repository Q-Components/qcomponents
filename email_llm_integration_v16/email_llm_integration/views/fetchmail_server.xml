<odoo>
  <record id="email_llm_fetchmail_server_form_view" model="ir.ui.view">
    <field name="name">email.llm.fetchmail.server.form</field>
    <field name="model">fetchmail.server</field>
    <field name="inherit_id" ref="mail.view_email_server_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='server_type']" position="after">
        <field name="use_for_llm_processing"/>
      </xpath>
    </field>
  </record>
</odoo>